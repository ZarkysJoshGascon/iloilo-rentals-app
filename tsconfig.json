{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./src/*"]
    },
    "noEmit": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "skipLibCheck": true,

    // The code was converted from JavaScript as it was. Strict checks can be
    // switched on a folder at a time as the types are filled in.
    "strict": false,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
